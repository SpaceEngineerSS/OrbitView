{
  "name": "orbitview",
  "version": "4.0.0",
  "description": "Real-time satellite tracking on a 3D globe with SGP4, pass prediction, Doppler, orbital lifetime and close-approach screening.",
  "author": "Mehmet Gümüş (spacegumus.com.tr)",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/SpaceEngineerSS/OrbitView"
  },
  "keywords": [
    "satellite",
    "tle",
    "sgp4",
    "cesium",
    "pass-prediction",
    "doppler",
    "orbital-mechanics"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "docs:snap": "node scripts/capture-screens.mjs",
    "postinstall": "node scripts/copy-cesium.mjs",
    "check": "tsc --noEmit && eslint && jest"
  },
  "dependencies": {
    "cesium": "^1.135.0",
    "framer-motion": "^12.34.0",
    "lucide-react": "^0.554.0",
    "next": "^16.3.8",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "satellite.js": "^6.0.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.33",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "puppeteer": "^24.35.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.6",
    "typescript": "^5"
  },
  "homepage": "https://orbitview-five.vercel.app"
}
